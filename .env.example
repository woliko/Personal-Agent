# Copy to .env and fill in. Never commit .env.
# Used by scripts/ (local dev). HA reads its own secrets from /config/secrets.yaml.

# Anthropic API — Sonnet for extraction/classification, Opus for synthesis.
ANTHROPIC_API_KEY=sk-ant-...

# Home Assistant — Tailscale IP of the Pi (see architecture.md).
# Replace 100.x.y.z with your own Tailnet IP.
HA_URL=http://100.x.y.z:8123
HA_TOKEN=

# Telegram bot — already configured in HA; needed only if a script pings directly.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
